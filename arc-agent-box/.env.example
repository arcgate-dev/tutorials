# A throwaway key that holds a little USDC on Arc mainnet (Arc's gas token is USDC). Never commit it.
# A key that other tutorials also use shares one box, and `npm run cleanup` empties it.
PRIVATE_KEY=
API_URL=https://api.arcgate.dev
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Where arcgate pushes messages: the https URL your tunnel prints for `npm run receiver`.
# The channel step and npm start refuse to run without it.
WEBHOOK_URL=
# The port `npm run receiver` listens on. Optional: 8787 by default.
# PORT=8787
# The token the watch step watches, searched for once. Optional: a default is built in.
# WATCH_TOKEN=
