# Authentication and wallet keys stay in mm; no credentials belong in this file.

# The public API.
API_URL=https://api.arcgate.dev

# Optional overrides. The defaults are pinned in src/config.js.
# A response cannot choose a different recipient or router.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARCGATE_PAY_TO=
# ARCGATE_ROUTER_ADDRESS=

# Sell at most 1 USDC for cirBTC. API fees and gas are additional.
SELL_AMOUNT=0.50
