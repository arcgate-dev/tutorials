{
  "name": "arc-claude-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Claude Agent SDK bot that sets up arcgate watches and works its box",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "watch": "node --env-file-if-exists=.env src/main.ts watch",
    "capture": "node --env-file-if-exists=.env src/main.ts capture",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/mcp": "2.27.0",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
