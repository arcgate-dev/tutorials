{
  "name": "arc-circle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Connect a Circle wallet to the public Arcgate API",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "inspect": "node --env-file-if-exists=.env src/main.js inspect",
    "connect": "node --env-file-if-exists=.env src/main.js connect",
    "search": "node --env-file-if-exists=.env src/main.js search",
    "quote": "node --env-file-if-exists=.env src/main.js quote",
    "preview": "node --env-file-if-exists=.env src/main.js preview",
    "trade": "node --env-file-if-exists=.env src/main.js trade",
    "wallet:create": "node --env-file-if-exists=.env src/create-wallet.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "10.8.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "viem": "2.56.9"
  }
}
