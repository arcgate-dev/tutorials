# Your own Circle developer-controlled EOA wallet.
# Copy this file to .env. Never commit .env or an entity-secret recovery file.
# The API names its payment network, and the key type must match it:
#   LIVE_API_KEY:...  with an ARC wallet          for Arc mainnet (eip155:5042), the public API
#   TEST_API_KEY:...  with an ARC-TESTNET wallet  for Arc testnet (eip155:5042002), the arcgate localnet
CIRCLE_API_KEY=LIVE_API_KEY:replace_me
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=

# The public API. For the arcgate localnet use: API_URL=http://127.0.0.1:19800
API_URL=https://api.arcgate.dev
# API_URL=http://127.0.0.1:19800

# Optional overrides. Each network has a default, pinned in src/config.js.
# A response cannot choose a different recipient or router.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# On the localnet, set ARCGATE_PAY_TO to the PAY_TO of your arcgate stack.
# ARCGATE_PAY_TO=
# ARCGATE_ROUTER_ADDRESS=

# Sell at most 1 USDC for cirBTC. API fees and gas are additional.
SELL_AMOUNT=1
