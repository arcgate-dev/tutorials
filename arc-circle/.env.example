# Your own Circle developer-controlled ARC (mainnet), EOA wallet.
# Copy this file to .env. Never commit .env or an entity-secret recovery file.
CIRCLE_API_KEY=LIVE_API_KEY:replace_me
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=

API_URL=https://api.arcgate.dev
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Public deployment addresses, checked 2026-09-28.
# These are pinned locally; a response cannot choose a different recipient/router.
ARCGATE_PAY_TO=0x08A4f8734ADAB08d3461E356b5A498b893Bd7B5e
ARCGATE_ROUTER_ADDRESS=0x6cf4f7785d479b9ec1c3abe2fb569525380baede

# Sell at most 1 USDC for cirBTC. API fees and gas are additional.
SELL_AMOUNT=1
