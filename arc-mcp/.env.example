# The payer: a throwaway key that holds a little USDC on Arc mainnet (Arc's gas token is USDC). It signs the x402 payments. Never commit it.
PRIVATE_KEY=
# The agent: the key whose address owns the box. It signs boxStatus and holds no funds. May be the payer's key, but a box is for good: use a key you can spare. One address is one box, shared by every tutorial run with the same key.
AGENT_PRIVATE_KEY=
# Optional: the arcgate API origin, https only. The tutorial adds /mcp.
API_URL=https://api.arcgate.dev
